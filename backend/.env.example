# Server mode and durable storage. On Render, mount a persistent disk at
# /var/data and set both values below before enabling production accounts.
NODE_ENV=production
APP_DATA_DIR=/var/data
APP_ALLOW_FILE_PERSISTENCE=true

# AAA online matches can use PostgreSQL instead of the single-instance mounted
# disk. Create the table from db/migrations/001_secure_state.sql, then provide
# the internal connection string through Render's secret environment editor.
# DATABASE_URL=postgresql://...
# APP_DATABASE_SSL=false

# Only browser origins that host the game may call the API cross-origin.
APP_ALLOWED_ORIGINS=https://appreciators-tcg-backend.onrender.com
APP_PUBLIC_URL=https://appreciators-tcg-backend.onrender.com/game

# Required for pack reward signatures that remain valid after a restart.
# Generate a unique 32+ byte secret; never commit the value.
PACK_REWARD_SIGNING_SECRET=

# Required in production so match replay/event-integrity signatures survive
# deploys. Generate a unique 32+ byte secret; never commit the value.
MATCH_EVENT_SIGNING_SECRET=

# ApeChain Originals ownership verification. The contract and all 20 imported
# 1-of-1 IDs are supplied so an RPC outage fails closed instead of granting a
# boss role from client data.
APECHAIN_RPC_URL=
APECHAIN_CHAIN_ID=33139
ORIGINALS_CONTRACT_ADDRESS=0xd92b263b48f74d0cd21f9d2c01b6cd06f2ab96cd
BOSS_ONE_OF_ONE_TOKEN_IDS=946,1329,1618,1778,2458,3196,3838,3949,3997,4152,4305,4389,4809,4814,5672,6136,6239,6382,6511,6604
